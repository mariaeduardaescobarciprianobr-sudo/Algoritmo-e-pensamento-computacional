#include <stdio.h>
#include <math.h>

int main() {
int x, y, z = 0, opção = -1;
int ano_nascimento, ano_atual;


printf("Digite o valor de X: ");
scanf("%d", &x);

printf("Digite o valor de Y: ");
scanf("%d", &y);

while (opção != 0) {
    printf("\nX = %d, Y = %d e Z = %d\n", x, y, z);

    printf("\nEscolha uma operação:\n");

    printf("1. Soma\n");

    printf("2. Subtração\n");

    printf("3. Multiplicação\n");

    printf("4. Divisão\n");

    printf("5. Média aritmética\n");

    printf("6. Porcentagem\n");

    printf("7. Regra de três\n");

    printf("8. Conversão de temperatura\n");

    printf("9. Conversão de unidades\n");

    printf("10. Cálculo de perímetro\n");

    printf("11. Cálculo de volume\n");

    printf("12. Cálculo de juros simples\n");

    printf("13. Cálculo de desconto\n");

    printf("14. Cálculo de velocidade média\n");

    printf("15. Cálculo de consumo\n");

    printf("16. Número par ou ímpar\n");

    printf("17. Comparação entre valores\n");

    printf("18. Cálculo de idade\n");

    printf("19. Potenciação\n");

    printf("0. Sair disso aqui\n");

    scanf("%d", &opção);

    switch (opção) {
        case 1: printf("Soma = %d\n", x + y); break;

        case 2: printf("Subtração = %d\n", x - y); break;

        case 3: printf("Multiplicação = %d\n", x * y); break;

        case 4: if (y != 0) { 
                printf("Divisão = %d\n", x / y);
            } else {
                printf("Como diabos eu vou dividir isso por zero?\n");
            } break;

        case 5: printf("Média aritmética = %d\n", (x + y) / 2); break;

        case 6: if (y != 0) {
                printf("X corresponde a %d%% de Y\n", (x * 100) / y);
            } else {
                printf("Não dá para calcular porcentagem com Y igual a zero.\n");
            } break;

        case 7: printf("Digite o valor de Z: ");
            scanf("%d", &z);

            if (x != 0) {
                printf("Regra de três = %d\n", (y * z) / x);
            } else {
                printf("Não é possível dividir por zero.\n");
            } break;

        case 8: printf("Digite a temperatura em Celsius: ");
            scanf("%d", &z);

            printf("Fahrenheit = %d\n", (z * 9 / 5) + 32);
            printf("Kelvin = %d\n", z + 273); break;

        case 9: printf("Digite o valor em metros: ");
            scanf("%d", &z);

            printf("Quilômetros = %d km\n", z / 1000);
            printf("Centímetros = %d cm\n", z * 100);
            printf("Milímetros = %d mm\n", z * 1000); break;

        case 10: printf("Digite a base: ");
            scanf("%d", &x);

            printf("Digite a altura: ");
            scanf("%d", &y);

            printf("Perímetro do retângulo = %d\n", 2 * (x + y)); break;

        case 11: printf("Digite o comprimento: ");
            scanf("%d", &x);

            printf("Digite a largura: ");
            scanf("%d", &y);

            printf("Digite a altura: ");
            scanf("%d", &z);

            printf("Volume = %d\n", x * y * z); break;

        case 12: printf("Digite o capital: ");
            scanf("%d", &x);

            printf("Digite a taxa de juros: ");
            scanf("%d", &y);

            printf("Digite o tempo: ");
            scanf("%d", &z);

            printf("Juros simples = %d\n", x * y * z / 100); break;

        case 13: printf("Digite o preço: ");
            scanf("%d", &x);

            printf("Digite o desconto (%%): ");
            scanf("%d", &y);

            printf("Valor do desconto = %d\n", x * y / 100);
            printf("Preço final = %d\n", x - (x * y / 100));
            break;

        case 14: printf("Digite a distância percorrida: ");
            scanf("%d", &x);

            printf("Digite o tempo gasto: ");
            scanf("%d", &y);

            if (y != 0) {
                printf("Velocidade média = %d\n", x / y);
            } else {
                printf("O tempo não pode ser zero.\n");
            } break;

        case 15: printf("Digite a distância percorrida em km: ");
            scanf("%d", &x);

            printf("Digite o combustível gasto em litros: ");
            scanf("%d", &y);

            if (y != 0) {
                printf("Consumo = %d km/L\n", x / y);
            } else {
                printf("O combustível não pode ser zero.\n");
            } break;

        case 16: if (x % 2 == 0) {
                printf("X = %d é par.\n", x);
            } else {
                printf("X = %d é ímpar.\n", x);
            }

            if (y % 2 == 0) {
                printf("Y = %d é par.\n", y);
            } else {
                printf("Y = %d é ímpar.\n", y);
            } break;

        case 17: if (x > y) {
                printf("X é maior que Y.\n");
            } else if (x < y) {
                printf("Y é maior que X.\n");
            } else {
                printf("X e Y são iguais.\n");
            } break;

        case 18: printf("Digite o ano de nascimento: ");
            scanf("%d", &ano_nascimento);

            printf("Digite o ano atual: ");
            scanf("%d", &ano_atual);

            if (ano_atual >= ano_nascimento) {
                printf("Idade = %d anos\n", ano_atual - ano_nascimento);
            } else {
                printf("O ano de nascimento não pode ser maior que o ano atual.\n");
            } break;

        case 19: printf("Potenciação = %.0f\n", pow(x, y)); break;

        case 0: printf("Programa encerrado.\n"); break;

        default:
            printf("É doido? Eu só vou de 1 a 19, aí aí...\n");
    }
}
return 0;


}
