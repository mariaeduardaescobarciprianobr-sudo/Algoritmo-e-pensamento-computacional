#include <stdio.h>
#include <math.h>

int main() {
    int x = 5, y = 7;

    printf("X = %d e Y = %d\n", x, y);
    
    printf("Soma = %d\n", x + y);

    printf("Subtração = %d\n", x - y);

    printf("Multiplicação = %d\n", x * y);

    printf("Divisão (x/y) = %.2f\n", (float)x / y);

    printf("Resto da divisão (x %% y) = %d\n", x % y);

    printf("Módulo de X = %.2f\n", fabs(x));

    printf("Potência de X elevado a Y = %.2f\n", pow(x, y));

    printf("Raiz quadrada de X = %.2f\n", sqrt(x));

    printf("Raiz quadrada de Y = %.2f\n", sqrt(y));

    printf("Média entre X e Y = %.2f\n", (float)(x + y) / 2);

    printf("Dobro de X = %d\n", x * 2);

    printf("Triplo de Y = %d\n", y * 3);

    printf("Quadrado de X = %d\n", x * x);

    printf("Quadrado de Y = %d\n", y * y);

    printf("Cubo de X = %d\n", x * x * x);

    printf("X corresponde a %.2f%% de Y\n", (float)x / y * 100);

    printf("Y corresponde a %.2f%% de X\n", (float)y / x * 100);

    printf("Distância entre X e Y = %.2f\n", fabs(x - y));

    printf("X + 10 = %d\n", x + 10);

    printf("Y - 3 = %d\n", y - 3);
    return 0;
}
