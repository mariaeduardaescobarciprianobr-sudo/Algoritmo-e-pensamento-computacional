#include <stdio.h>

int main() {
    float temperatura;
    
    printf("Iniciando monitoramento da temperatura...\n");
    printf("Digite a temperatura (\n°C): ");
    scanf("%f", &temperatura);
    
    while (temperatura < 80) {
        printf("Temperatura atual: %.1f \n°C\n", temperatura);
        printf("Digite a temperatura (\n°C): ");
        scanf("%f", &temperatura);
    }
    
    printf("\nALERTA: temperatura acima do limite\n");
   return 0;
}
